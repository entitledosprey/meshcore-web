MESH_HOSTNAME=mesh.example.com
CF_API_TOKEN=your_cloudflare_token_with_zone_dns_edit
MESH_BASIC_USER=admin
# bcrypt hash with every $ doubled, see README
MESH_BASIC_HASH=$$2a$$14$$replace_me
TZ=Etc/UTC

# Telemetry (optional). Leave INFLUX_URL/INFLUX_TOKEN empty and the console
# runs exactly as before, with the collector inert. See README > Telemetry.
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=home
INFLUX_BUCKET=meshcore
# Defaults to the radio's own advertised name.
TELEMETRY_NODE=
# Repeater neighbour tables: heaviest request a repeater serves. Opt-in.
TELEMETRY_NEIGHBOURS=0
