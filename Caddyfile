{$MESH_HOSTNAME} {
	tls {
		dns cloudflare {$CF_API_TOKEN}
		# No `resolvers` here on purpose: pointing the propagation check at a
		# recursive resolver means the challenge name gets looked up before it
		# exists, and the resulting NXDOMAIN is cached negatively for far longer
		# than the challenge lasts. Checking the authoritative servers avoids it.
		propagation_delay 20s
		propagation_timeout 5m
	}

	encode zstd gzip

	# The event stream and console are websockets; reverse_proxy handles the
	# upgrade, but the console can sit idle between commands.
	reverse_proxy meshcore-web:8000 {
		flush_interval -1
	}
}
