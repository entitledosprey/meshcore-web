{$MESH_HOSTNAME} {
	tls {
		dns cloudflare {$CF_API_TOKEN}

		# propagation_timeout -1 disables the local pre-flight DNS check.
		# It is not a workaround for a broken DNS provider: on a network whose
		# gateway transparently intercepts port 53 and serves cached answers,
		# the check queries the interceptor rather than the real nameservers.
		# A negative answer cached before the record existed then pins the
		# challenge name to NXDOMAIN for the whole attempt. Let's Encrypt
		# validates from the public internet, where the record is visible, so
		# the delay below is what actually matters.
		propagation_delay 45s
		propagation_timeout -1
	}

	encode zstd gzip

	# The event stream and console are websockets; reverse_proxy handles the
	# upgrade, but the console can sit idle between commands.
	reverse_proxy meshcore-web:8000 {
		flush_interval -1
	}
}
